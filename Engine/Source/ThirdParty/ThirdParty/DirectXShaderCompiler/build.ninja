e tools/clang/include/clang/Basic/ClangDiagnosticSema tools/clang/include/clang/Basic/ClangDiagnosticSerialization tools/clang/include/clang/Parse/ClangAttrParserStringSwitches tools/clang/include/clang/Sema/ClangAttrParsedAttrImpl tools/clang/include/clang/Sema/ClangAttrParsedAttrKinds tools/clang/include/clang/Sema/ClangAttrParsedAttrList tools/clang/include/clang/Sema/ClangAttrSpellingListIndex tools/clang/include/clang/Sema/ClangAttrTemplateInstantiate tools/clang/include/clang/Serialization/ClangAttrPCHRead tools/clang/include/clang/Serialization/ClangAttrPCHWrite
  DEP_FILE = tools/clang/tools/dxv/CMakeFiles/dxv.dir/link.d
  FLAGS = -fPIC -fvisibility-inlines-hidden -fvisibility=hidden -Wall -W -Wno-unused-parameter -Wwrite-strings -Wimplicit-fallthrough -Wcast-qual -Wno-unknown-pragmas -Wno-unused-but-set-variable -Wno-deprecated-copy -Wmissing-field-initializers -pedantic -Wno-long-long -Wno-switch -Wno-comment -fcolor-diagnostics -fms-extensions -Wno-language-extension-token -ffunction-sections -fdata-sections -fno-common -Woverloaded-virtual -fno-strict-aliasing -Wno-nested-anon-types -O3 -DNDEBUG
  LINK_FLAGS = -Wl,-allow-shlib-undefined    -Wl,-O3 -Wl,--gc-sections  -Xlinker --dependency-file=tools/clang/tools/dxv/CMakeFiles/dxv.dir/link.d
  LINK_LIBRARIES = -Wl,-rpath,"\$$ORIGIN/../lib"  lib/libLLVMDxcSupport.a  lib/libLLVMOption.a  lib/libLLVMMSSupport.a  lib/libLLVMDxilContainer.a  lib/libdxcompiler.so  lib/libLLVMBitWriter.a  lib/libLLVMTransformUtils.a  lib/libLLVMipa.a  lib/libLLVMAnalysis.a  lib/libLLVMDXIL.a  lib/libLLVMDxcSupport.a  lib/libLLVMBitReader.a  lib/libLLVMCore.a  lib/libLLVMSupport.a  lib/libLLVMMSSupport.a  -lrt  -ldl  -lpthread  -lz  -lm
  OBJECT_DIR = tools/clang/tools/dxv/CMakeFiles/dxv.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = tools/clang/tools/dxv/CMakeFiles/dxv.dir/
  TARGET_FILE = bin/dxv-3.7
  TARGET_PDB = bin/dxv.pdb


