{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Editor — GDB",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/out/build/Clang-linux-debug/Engine/Source/Editor/Editor",
            "cwd": "${workspaceFolder}",

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "externalConsole": false,

            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": false
                },
                {
                    "description": "Enable structured printing",
                    "text": "-interpreter-exec console \"set print pretty on\"",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable string truncation",
                    "text": "-interpreter-exec console \"set print characters unlimited\"",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}